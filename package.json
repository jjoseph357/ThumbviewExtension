{
  "name": "thumbview",
  "displayName": "Thumbview",
  "publisher": "Thumbview",
  "version": "0.4.6",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jjoseph357/ThumbviewExtension"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Thumbview",
      "properties": {
        "thumbview.layoutMode": {
          "type": "string",
          "enum": [
            "uniform_grid",
            "spanning_grid"
          ],
          "enumDescriptions": [
            "Standard uniform grid (1 cell per file)",
            "Spanning Grid (tall files span multiple vertical cells)"
          ],
          "default": "spanning_grid",
          "description": "Select the layout algorithm mode for displaying codebase thumbnails."
        },
        "thumbview.dragReorderMode": {
          "type": "string",
          "enum": [
            "swap",
            "shift"
          ],
          "enumDescriptions": [
            "If thumbnails are the same shape, they will simply swap positions.",
            "Thumbnails will be shifted down and to the left in column order, reflowing the layout."
          ],
          "default": "swap",
          "description": "Select the drag-and-drop behaviour when manually re-arranging thumbnails."
        },
        "thumbview.autoIgnoreThreshold": {
          "type": "number",
          "default": 30,
          "description": "Automatically ignore subdirectories containing more than this number of files (set to 0 to disable)."
        },
        "thumbview.renderMediaThumbnails": {
          "type": "boolean",
          "default": true,
          "description": "Whether image and PDF thumbnails are rendered inside Thumbview tiles."
        },
        "thumbview.minCellWidth": {
          "type": "number",
          "default": 32,
          "description": "Minimum tile width in pixels before grouping workspace files into subfolder cards."
        },
        "thumbview.minCellHeight": {
          "type": "number",
          "default": 28,
          "description": "Minimum tile height in pixels before grouping workspace files into subfolder cards."
        }
      }
    },
    "commands": [
      {
        "command": "thumbview.open",
        "title": "Thumbview: Open Thumbview",
        "icon": "media/icon.svg"
      },
      {
        "command": "thumbview.reflow",
        "title": "Thumbview: Reflow Layout"
      },
      {
        "command": "thumbview.setUniformGrid",
        "title": "Thumbview: Use Uniform Grid Layout"
      },
      {
        "command": "thumbview.setSpanningGrid",
        "title": "Thumbview: Use Spanning Grid Layout"
      },
      {
        "command": "thumbview.setSwapReorderMode",
        "title": "Thumbview: Use Swap Reorder Mode"
      },
      {
        "command": "thumbview.setShiftReorderMode",
        "title": "Thumbview: Use Shift Reorder Mode"
      },
      {
        "command": "thumbview.expandSpace",
        "title": "Thumbview: Expand Grid Space"
      },
      {
        "command": "thumbview.reduceSpace",
        "title": "Thumbview: Reduce Grid Space"
      },
      {
        "command": "thumbview.addIgnorePattern",
        "title": "Thumbview: Add Ignore Pattern...",
        "icon": "$(add)"
      },
      {
        "command": "thumbview.removeIgnorePattern",
        "title": "Thumbview: Unignore Directory",
        "icon": "$(eye)"
      },
      {
        "command": "thumbview.focusFolder",
        "title": "Thumbview: Focus Directory in Thumbview",
        "icon": "$(eye)"
      },
      {
        "command": "thumbview.showAllFolders",
        "title": "Thumbview: Show All Workspace Directories",
        "icon": "$(clear-all)"
      },
      {
        "command": "thumbview.ignoreDirectory",
        "title": "Thumbview: Ignore Directory",
        "icon": "$(eye-closed)"
      },
      {
        "command": "thumbview.deleteDirectory",
        "title": "Thumbview: Delete Directory",
        "icon": "$(trash)"
      },
      {
        "command": "thumbview.deleteIgnoredItem",
        "title": "Thumbview: Delete Ignored Item",
        "icon": "$(trash)"
      },
      {
        "command": "thumbview.revealInExplorer",
        "title": "Thumbview: Reveal File in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "thumbview.configureHotkey",
        "title": "Thumbview: Configure Hotkey (Keyboard Shortcuts)",
        "icon": "$(keyboard)"
      }
    ],
    "keybindings": [
      {
        "command": "thumbview.open",
        "key": "f4"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "thumbview-container",
          "title": "Thumbview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "thumbview-container": [
        {
          "id": "thumbview-sidebar",
          "name": "Thumbview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "thumbview-sidebar",
        "contents": "Thumbview is a full-workspace visual minimap grid.\n\n[Open Thumbview](command:thumbview.open)\n\n[Configure Hotkey](command:thumbview.configureHotkey)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile && node out/test/spanning_reorder.test.js && node out/test/bottom_drag.test.js && node out/test/empty_space_drag.test.js && node src/test/overview_diagnose.test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "~1.107.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}