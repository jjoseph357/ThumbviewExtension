{
  "name": "thumbview",
  "displayName": "Thumbview",
  "publisher": "Thumbview",
  "version": "0.0.5",
  "engines": {
    "vscode": "^1.107.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Thumbview",
      "properties": {
        "thumbview.layoutMode": {
          "type": "string",
          "enum": [
            "uniform_grid",
            "spanning_grid"
          ],
          "enumDescriptions": [
            "Standard uniform grid (1 cell per file)",
            "Spanning Grid (tall files span multiple vertical cells)"
          ],
          "default": "uniform_grid",
          "description": "Select the layout algorithm mode for displaying codebase minimaps."
        }
      }
    },
    "commands": [
      {
        "command": "thumbview.open",
        "title": "Thumbview",
        "icon": "media/icon.svg"
      },
      {
        "command": "thumbview.reflow",
        "title": "Reflow Layout"
      },
      {
        "command": "thumbview.setUniformGrid",
        "title": "Use Uniform Grid Layout"
      },
      {
        "command": "thumbview.setSpanningGrid",
        "title": "Use Spanning Grid Layout"
      }
    ],
    "keybindings": [
      {
        "command": "thumbview.open",
        "key": "f4"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "thumbview-container",
          "title": "Thumbview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "thumbview-container": [
        {
          "id": "thumbview-sidebar",
          "name": "Thumbview Actions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "thumbview-sidebar",
        "contents": "Manage your visual workspace.\n\n[Open Thumbview (F4)](command:thumbview.open)\n\n[Reflow Layout](command:thumbview.reflow)\n\n--- Layout Mode ---\n\n[Switch to Uniform Grid](command:thumbview.setUniformGrid)\n\n[Switch to Spanning Grid](command:thumbview.setSpanningGrid)\n\n--- Shortcuts ---\n\n• Click '×' or Middle-click open tab cards to close tabs\n• Click card header path label to isolate folder view"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}