{
  "name": "thumbview",
  "displayName": "Thumbview",
  "publisher": "Thumbview",
  "version": "0.3.6",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jjoseph357/ThumbviewExtension"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Thumbview",
      "properties": {
        "thumbview.layoutMode": {
          "type": "string",
          "enum": [
            "uniform_grid",
            "spanning_grid"
          ],
          "enumDescriptions": [
            "Standard uniform grid (1 cell per file)",
            "Spanning Grid (tall files span multiple vertical cells)"
          ],
          "default": "spanning_grid",
          "description": "Select the layout algorithm mode for displaying codebase minimaps."
        },
        "thumbview.autoIgnoreThreshold": {
          "type": "number",
          "default": 30,
          "description": "Automatically ignore subdirectories containing more than this number of files (set to 0 to disable)."
        },
        "thumbview.renderMediaThumbnails": {
          "type": "boolean",
          "default": true,
          "description": "Whether image and PDF thumbnails are rendered inside Thumbview tiles."
        },
        "thumbview.minCellWidth": {
          "type": "number",
          "default": 32,
          "description": "Minimum tile width in pixels before grouping workspace files into subfolder cards."
        },
        "thumbview.minCellHeight": {
          "type": "number",
          "default": 28,
          "description": "Minimum tile height in pixels before grouping workspace files into subfolder cards."
        }
      }
    },
    "commands": [
      {
        "command": "thumbview.open",
        "title": "Thumbview",
        "icon": "media/icon.svg"
      },
      {
        "command": "thumbview.reflow",
        "title": "Reflow Layout"
      },
      {
        "command": "thumbview.setUniformGrid",
        "title": "Use Uniform Grid Layout"
      },
      {
        "command": "thumbview.setSpanningGrid",
        "title": "Use Spanning Grid Layout"
      },
      {
        "command": "thumbview.addIgnorePattern",
        "title": "Add Ignore Pattern...",
        "icon": "$(add)"
      },
      {
        "command": "thumbview.removeIgnorePattern",
        "title": "Unignore Directory",
        "icon": "$(eye)"
      },
      {
        "command": "thumbview.focusFolder",
        "title": "Focus Directory in Thumbview",
        "icon": "$(eye)"
      },
      {
        "command": "thumbview.showAllFolders",
        "title": "Show All Workspace Directories",
        "icon": "$(clear-all)"
      },
      {
        "command": "thumbview.ignoreDirectory",
        "title": "Ignore Directory",
        "icon": "$(eye-closed)"
      },
      {
        "command": "thumbview.deleteDirectory",
        "title": "Delete Directory",
        "icon": "$(trash)"
      },
      {
        "command": "thumbview.deleteIgnoredItem",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "thumbview.revealInExplorer",
        "title": "Reveal in Explorer",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "thumbview.addIgnorePattern",
          "when": "view == thumbview-ignores",
          "group": "navigation@1"
        },
        {
          "command": "thumbview.showAllFolders",
          "when": "view == thumbview-directories",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "thumbview.removeIgnorePattern",
          "when": "view == thumbview-ignores && viewItem == ignoreItem",
          "group": "inline@1"
        },
        {
          "command": "thumbview.removeIgnorePattern",
          "when": "view == thumbview-ignores && viewItem == ignoreItem",
          "group": "1_modification@1"
        },
        {
          "command": "thumbview.ignoreDirectory",
          "when": "view == thumbview-directories && viewItem == directoryItem",
          "group": "inline@1"
        },
        {
          "command": "thumbview.ignoreDirectory",
          "when": "view == thumbview-directories && viewItem == directoryItem",
          "group": "1_modification@1"
        },
        {
          "command": "thumbview.removeIgnorePattern",
          "when": "view == thumbview-directories && viewItem == ignoredDirectoryItem",
          "group": "inline@1"
        },
        {
          "command": "thumbview.removeIgnorePattern",
          "when": "view == thumbview-directories && viewItem == ignoredDirectoryItem",
          "group": "1_modification@1"
        },
        {
          "command": "thumbview.revealInExplorer",
          "when": "view == thumbview-directories && (viewItem == directoryItem || viewItem == ignoredDirectoryItem)",
          "group": "0_navigation@1"
        },
        {
          "command": "thumbview.deleteDirectory",
          "when": "view == thumbview-directories && (viewItem == directoryItem || viewItem == ignoredDirectoryItem)",
          "group": "7_modification@1"
        },
        {
          "command": "thumbview.revealInExplorer",
          "when": "view == thumbview-ignores && viewItem == ignoreItem",
          "group": "0_navigation@1"
        },
        {
          "command": "thumbview.deleteIgnoredItem",
          "when": "view == thumbview-ignores && viewItem == ignoreItem",
          "group": "7_modification@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "thumbview.open",
        "key": "f4"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "thumbview-container",
          "title": "Thumbview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "thumbview-container": [
        {
          "id": "thumbview-sidebar",
          "name": "Actions & Settings",
          "icon": "media/icon.svg",
          "size": 3
        },
        {
          "id": "thumbview-directories",
          "name": "Directory Navigation",
          "icon": "media/icon.svg",
          "size": 6
        },
        {
          "id": "thumbview-ignores",
          "name": "Ignored Files & Directories",
          "icon": "media/icon.svg",
          "size": 1
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "thumbview-sidebar",
        "contents": "2D minimap grid of your whole workspace.\n\n[Open Thumbview (F4)](command:thumbview.open)\n\nLayout Settings\n\n[Uniform Grid](command:thumbview.setUniformGrid)\n\n[Spanning Grid](command:thumbview.setSpanningGrid)\n\n[Reflow Layout](command:thumbview.reflow)\n\nRight-click files or folders to ignore them, or add ignore patterns.\n\n[Add Ignore Pattern](command:thumbview.addIgnorePattern)\n\nMore: ⚙ Actions & Shortcuts button in the grid, or the README."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "~1.107.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}